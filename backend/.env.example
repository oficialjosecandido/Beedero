DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local dev: http://localhost:3000
# Production: set this to the public frontend URL, e.g. https://beedero-web.azurewebsites.net
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required in every environment — the app always uses Postgres, there is no
# SQLite fallback.
DATABASE_URL=postgresql://user:password@host:5432/dbname
CSRF_TRUSTED_ORIGINS=https://example.azurewebsites.net
# Required in every environment — media (e.g. profile pictures) is always
# stored in Azure Blob Storage, there is no local-disk fallback.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media
# Required in every environment — transactional email (verification, password
# reset) always goes through Azure Communication Services, there is no SMTP
# fallback.
AZURE_COMMUNICATION_CONNECTION_STRING=
DEFAULT_FROM_EMAIL=DoNotReply@example.azurecomm.net
# Protects POST /api/internal/run-job/ (scheduled management commands).
MANAGEMENT_SECRET=
# Public origin of this API — used for links (digest unsubscribe/pixel) that
# email clients fetch directly. Production: the public backend URL.
BACKEND_URL=http://localhost:8000
# Optional — error monitoring (no-op when unset).
SENTRY_DSN=
# Optional — Microsoft Entra External ID (CIAM). Leave all unset to keep
# native SimpleJWT auth as the only path; EntraJWTAuthentication no-ops until
# both ENTRA_TENANT_ID and (ENTRA_TENANT_SUBDOMAIN or ENTRA_CUSTOM_DOMAIN)
# plus ENTRA_API_CLIENT_ID are set. See docs/entra-migration.md.
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_CUSTOM_DOMAIN=
ENTRA_API_CLIENT_ID=
