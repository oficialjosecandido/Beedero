DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production: if set, uses Postgres instead of the SQLite fallback.
DATABASE_URL=postgresql://user:password@host:5432/dbname
CSRF_TRUSTED_ORIGINS=https://example.azurewebsites.net
# Production: if set (with the key below), profile pictures upload to Azure
# Blob Storage instead of local disk.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media
