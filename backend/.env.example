DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local dev: http://localhost:3000
# Production: set this to the public frontend URL, e.g. https://beedero-web.azurewebsites.net
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required in every environment — the app always uses Postgres, there is no
# SQLite fallback.
DATABASE_URL=postgresql://user:password@host:5432/dbname
CSRF_TRUSTED_ORIGINS=https://example.azurewebsites.net
# Required in every environment — media (e.g. profile pictures) is always
# stored in Azure Blob Storage, there is no local-disk fallback.
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media
# Required in every environment — transactional email (verification, password
# reset) always goes through Azure Communication Services, there is no SMTP
# fallback.
AZURE_COMMUNICATION_CONNECTION_STRING=
DEFAULT_FROM_EMAIL=DoNotReply@example.azurecomm.net
